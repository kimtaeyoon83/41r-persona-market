{
  "name": "@41rpm/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true,
      "es2022": true
    },
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "ecmaVersion": 2022,
      "sourceType": "module"
    },
    "plugins": [
      "@typescript-eslint"
    ],
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended"
    ],
    "ignorePatterns": [
      "dist/**",
      "drizzle/**",
      "node_modules/**",
      "*.cjs"
    ],
    "rules": {
      "@typescript-eslint/no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_",
          "varsIgnorePattern": "^_",
          "caughtErrorsIgnorePattern": "^_"
        }
      ],
      "@typescript-eslint/no-explicit-any": "warn",
      "no-empty": [
        "error",
        {
          "allowEmptyCatch": true
        }
      ],
      "@typescript-eslint/no-var-requires": "off"
    },
    "overrides": [
      {
        "files": [
          "src/__tests__/**/*.ts"
        ],
        "rules": {
          "@typescript-eslint/no-explicit-any": "off",
          "@typescript-eslint/no-non-null-assertion": "off"
        }
      }
    ]
  },
  "dependencies": {
    "@41rpm/shared": "workspace:*",
    "@41rpm/solana-utils": "workspace:*",
    "@anthropic-ai/sdk": "^0.78.0",
    "@aws-sdk/client-s3": "^3.1022.0",
    "@browserbasehq/stagehand": "^3.1.0",
    "@privy-io/server-auth": "^1.32.5",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@x402/core": "^2.5.0",
    "@x402/evm": "^2.10.0",
    "@x402/express": "^2.5.0",
    "@x402/svm": "^2.5.0",
    "bip39": "^3.1.0",
    "bs58": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.0",
    "ed25519-hd-key": "^2.0.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.3.2",
    "pg": "^8.13.0",
    "pino": "^10.3.1",
    "playwright-core": "^1.59.1",
    "sas-lib": "^1.0.10",
    "tweetnacl": "^1.0.3",
    "viem": "^2.48.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "drizzle-kit": "^0.30.0",
    "eslint": "^8.57.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
