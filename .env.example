# Database
DATABASE_URL=postgresql://admin:admin41rpm@localhost:5432/persona_market

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_KEYPAIR_PATH=~/.config/solana/id.json

# Claude API
ANTHROPIC_API_KEY=

# Stagehand
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Ports
API_PORT=4100
NEXT_PUBLIC_API_URL=http://localhost:4100

# 41R Token (Token-2022 with 5% transfer fee)
TOKEN_41R_MINT=

# SAS (Solana Attestation Service) — run `pnpm tsx scripts/setup-sas.ts`
SAS_CREDENTIAL_PDA=
SAS_SCHEMA_PDA=

# x402 (Solana)
X402_RESOURCE_WALLET=

# x402 (BSC testnet — EVM)
BSC_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
BSC_CHAIN_ID=97
BSC_MOCKUSDC_ADDRESS=               # deployed address from `pnpm --filter @41rpm/contracts deploy:bsc-testnet`
X402_EVM_RESOURCE_WALLET=           # EVM address that receives BSC USDC payments
EVM_FACILITATOR_PRIVATE_KEY=        # 0x... server key that executes transferWithAuthorization (needs tBNB for gas)

# Contracts deploy
DEPLOYER_PRIVATE_KEY=               # 0x... for packages/contracts hardhat deploy (needs tBNB)
BSCSCAN_API_KEY=                    # optional, for auto-verify on BscScan

# Public (exposed to Next.js frontend)
NEXT_PUBLIC_BSC_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
NEXT_PUBLIC_BSC_CHAIN_ID=97
NEXT_PUBLIC_BSC_MOCKUSDC_ADDRESS=
NEXT_PUBLIC_X402_EVM_RESOURCE_WALLET=

# CORS allowlist — comma-separated origins. Defaults cover local dev + Railway web.
# Override only when adding a custom domain.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# --- Local dev / demo flags (ignored in production) ---
# SKIP_PAYMENT_VERIFY=true  # skip on-chain USDC verification on /api/autotest/run
# USE_X402_FALLBACK=true    # use custom USDC verification instead of x402 facilitator
